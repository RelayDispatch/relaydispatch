{
  "name": "relaydispatch",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source AI-powered field service dispatch platform",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "dev:web": "tsx apps/web/server.ts",
    "dev:worker": "tsx apps/worker/src/index.ts",
    "dev:scheduler": "tsx apps/scheduler/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "dlq-poller": "tsx apps/scheduler/src/dlq.ts",
    "retention-worker": "tsx apps/scheduler/src/retention.ts",
    "idempotency-purge": "tsx apps/scheduler/src/idempotency.ts",
    "build": "npm run build:web && npm run build:api",
    "build:web": "vite build && esbuild apps/web/server.ts --bundle --platform=node --format=cjs --external:express --external:vite --sourcemap --outfile=dist/server.cjs",
    "build:api": "tsc --project tsconfig.backend.json",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "typecheck": "npm run typecheck:web && npm run typecheck:api",
    "typecheck:web": "tsc --noEmit",
    "typecheck:api": "tsc --project tsconfig.backend.json --noEmit",
    "lint": "eslint . --ext .ts,.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate:org-secrets-cutover": "node scripts/migrate-org-secrets-cutover.mjs",
    "migrate:org-secrets-drop-plaintext": "node scripts/drop-org-secrets-plaintext-columns.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.7.6",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.220.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/resources": "^2.7.0",
    "@opentelemetry/sdk-metrics": "^2.7.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@supabase/supabase-js": "^2.106.1",
    "@tailwindcss/vite": "^4.1.14",
    "@temporalio/activity": "^1.11.0",
    "@temporalio/client": "^1.11.0",
    "@temporalio/common": "^1.11.0",
    "@temporalio/worker": "^1.11.0",
    "@temporalio/workflow": "^1.11.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "hono": "^4.12.28",
    "html-to-text": "^10.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nylas": "^8.4.0",
    "openai": "^6.33.0",
    "pino": "^9.6.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.1",
    "tailwind-merge": "^3.6.0",
    "twilio": "^6.0.2",
    "uuid": "^11.1.0",
    "vite": "^6.4.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@temporalio/testing": "^1.20.2",
    "@types/express": "^5.0.6",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.14.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitest/coverage-v8": "^3.2.6",
    "autoprefixer": "^10.4.21",
    "concurrently": "^8.2.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.22.0",
    "msw": "^2.12.14",
    "pino-pretty": "^13.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "ws": "^8.21.0",
    "shell-quote": "^1.9.0",
    "form-data": "^4.0.6",
    "js-yaml": "^4.1.0"
  }
}
