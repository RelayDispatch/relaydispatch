# ══════════════════════════════════════════════════════════════════════════════
# RelayDispatch — Environment Variable Reference
# ══════════════════════════════════════════════════════════════════════════════
#
# Copy this file to .env and fill in your values.
# NEVER commit your real .env file to version control.
#
# Legend:
#   [REQUIRED]  — The application will refuse to start without this.
#   [OPTIONAL]  — Sane defaults exist; feature degrades gracefully if unset.
#   [FEATURE]   — Only needed if you enable the corresponding feature.
# ══════════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────
# APPLICATION
# ──────────────────────────────────────────────────────────────

# [REQUIRED] Your application's public base URL (used for OAuth callbacks, Stripe redirects)
APP_BASE_URL=http://localhost:3000

# [OPTIONAL] URL used in AI HTTP-Referer headers (helps OpenRouter identify your app)
APP_URL=http://localhost:3000

# [OPTIONAL] Server port for the Hono API (default: 3001 in dev, 3000 in prod)
PORT=3001

# [OPTIONAL] Node environment
NODE_ENV=development


# ──────────────────────────────────────────────────────────────
# AGENT IDENTITY (fully configurable — remove all branding)
# ──────────────────────────────────────────────────────────────

# [OPTIONAL] Name of the AI dispatch agent shown in email signatures
# Default: Dispatch
AGENT_NAME=Dispatch

# [OPTIONAL] Brand name shown in bot disclosure footer (SB 243 compliance)
# Default: RelayDispatch
AGENT_BRAND=RelayDispatch


# ──────────────────────────────────────────────────────────────
# SUPABASE (database + auth)
# Create a project at https://supabase.com
# Apply schema: packages/database/schema/setup.sql
# ──────────────────────────────────────────────────────────────

# [REQUIRED] Your Supabase project URL
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# [REQUIRED] Supabase anonymous/public key (safe for client-side use)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# [REQUIRED] Supabase service role key — NEVER expose to the browser.
# Used only in server-side webhook and worker contexts.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# ──────────────────────────────────────────────────────────────
# FRONTEND (Vite — must be prefixed with VITE_)
# ──────────────────────────────────────────────────────────────

# [REQUIRED] Same as SUPABASE_URL — needed by the frontend build
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# [REQUIRED] Same as SUPABASE_ANON_KEY — needed by the frontend build
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.REPLACE_ME

# [REQUIRED] API server URL used by the React SPA
VITE_API_URL=http://localhost:3001


# ──────────────────────────────────────────────────────────────
# SECURITY
# ──────────────────────────────────────────────────────────────

# [REQUIRED] 64-character hex string for AES-256-GCM PII vault encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# WARNING: Changing this key invalidates all existing encrypted vault data.
VAULT_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARS_GENERATED_LOCALLY

# [OPTIONAL] Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001


# ──────────────────────────────────────────────────────────────
# AI — OpenRouter (unified gateway for all LLM calls)
# Get your key at https://openrouter.ai
# ──────────────────────────────────────────────────────────────

# [REQUIRED] OpenRouter API key — used for ALL AI calls (Claude, Gemini)
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME


# ──────────────────────────────────────────────────────────────
# EMAIL — Nylas (email read/send)
# Create a grant at https://dashboard.nylas.com
# ──────────────────────────────────────────────────────────────

# [REQUIRED] Nylas API key
NYLAS_API_KEY=nyk_v0_REPLACE_ME


# ──────────────────────────────────────────────────────────────
# TEMPORAL (durable workflow engine)
# Download CLI: https://temporal.io/download
# Start local server: temporal server start-dev --namespace relaydispatch-dispatch
# ──────────────────────────────────────────────────────────────

# [REQUIRED] Temporal server address
TEMPORAL_ADDRESS=localhost:7233

# [REQUIRED] Temporal namespace — must match your Temporal server configuration
TEMPORAL_NAMESPACE=relaydispatch-dispatch

# [REQUIRED] Temporal task queue — worker and API must use the same value
TEMPORAL_TASK_QUEUE=relaydispatch-dispatch


# ──────────────────────────────────────────────────────────────
# GMAIL PUB/SUB WEBHOOK
# Set up a Google Cloud Pub/Sub push subscription pointing to /intake/gmail
# ──────────────────────────────────────────────────────────────

# [REQUIRED in production] HMAC-SHA256 secret shared with GCP Pub/Sub
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_PUBSUB_HMAC_SECRET=REPLACE_WITH_64_HEX_CHARS

# [OPTIONAL] Legacy token check (defence-in-depth alongside HMAC)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GMAIL_PUBSUB_VERIFY_TOKEN=REPLACE_WITH_64_HEX_CHARS


# ──────────────────────────────────────────────────────────────
# RATE LIMITING — Upstash Redis (optional — graceful no-op if unset)
# Create a Redis database at https://upstash.com
# ──────────────────────────────────────────────────────────────

# [OPTIONAL] Upstash Redis REST URL
UPSTASH_REDIS_REST_URL=https://YOUR_REDIS.upstash.io

# [OPTIONAL] Upstash Redis REST token
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME


# ──────────────────────────────────────────────────────────────
# AI COST GUARDRAILS (optional)
# ──────────────────────────────────────────────────────────────

# [OPTIONAL] Per-org daily LLM cost limit in USD (default: $5)
ORG_COST_LIMIT_USD_DAILY=5

# [OPTIONAL] Per-org monthly LLM cost limit in USD (default: $100)
ORG_COST_LIMIT_USD_MONTHLY=100


# ──────────────────────────────────────────────────────────────
# ORG LIMITS (optional — all orgs get unlimited access if not set)
# ──────────────────────────────────────────────────────────────

# [OPTIONAL] Set to "true" to enable per-org resource limits
ENABLE_ORG_LIMITS=false

# [OPTIONAL] Maximum threads per org per month (only if ENABLE_ORG_LIMITS=true)
# MAX_THREADS_PER_ORG=500

# [OPTIONAL] Maximum active technicians per org (only if ENABLE_ORG_LIMITS=true)
# MAX_TECHNICIANS_PER_ORG=25


# ──────────────────────────────────────────────────────────────
# IDEMPOTENCY PURGE (optional)
# ──────────────────────────────────────────────────────────────

# [OPTIONAL] Interval in ms for TTL purge of api_idempotency_responses (default: 1 hour)
# Set to "0" or "disabled" to use the standalone idempotency-purge worker instead
IDEMPOTENCY_PURGE_INTERVAL_MS=3600000


# ──────────────────────────────────────────────────────────────
# OBSERVABILITY — OpenTelemetry (optional — no-ops if not configured)
# ──────────────────────────────────────────────────────────────

# [OPTIONAL] OTLP endpoint for traces and metrics (e.g., Grafana Cloud, Honeycomb, Jaeger)
# OTEL_EXPORTER_OTLP_ENDPOINT=https://your-otlp-endpoint

# [OPTIONAL] DLQ depth alert threshold (default: 10 unresolved items)
DLQ_ALERT_THRESHOLD=10


# ──────────────────────────────────────────────────────────────
# CRM INTEGRATIONS
# ──────────────────────────────────────────────────────────────

# [OPTIONAL] CRM dispatch provider: local | jobber | servicetitan | housecall
# "local" = jobs are stored in the RelayDispatch database only (default)
DISPATCH_PROVIDER=local

# ── Jobber (https://developer.getjobber.com) ──
# [FEATURE] Required if DISPATCH_PROVIDER=jobber
JOBBER_CLIENT_ID=REPLACE_ME
JOBBER_CLIENT_SECRET=REPLACE_ME

# ── ServiceTitan (https://developer.servicetitan.io) ──
# [FEATURE] Required if DISPATCH_PROVIDER=servicetitan
SERVICETITAN_CLIENT_ID=REPLACE_ME
SERVICETITAN_CLIENT_SECRET=REPLACE_ME
SERVICETITAN_APP_KEY=REPLACE_ME
SERVICETITAN_TENANT_ID=REPLACE_ME

# ── Housecall Pro (https://developer.housecallpro.com) ──
# [FEATURE] Required if DISPATCH_PROVIDER=housecall
HOUSECALL_CLIENT_ID=REPLACE_ME
HOUSECALL_CLIENT_SECRET=REPLACE_ME


# ──────────────────────────────────────────────────────────────
# GOOGLE OAUTH (optional — for Gmail grant setup flow)
# ──────────────────────────────────────────────────────────────

# [FEATURE] Required if using Google OAuth for org Gmail setup
GOOGLE_CLIENT_ID=REPLACE_ME
GOOGLE_CLIENT_SECRET=REPLACE_ME


# ──────────────────────────────────────────────────────────────
# TWILIO VOICE AI (BETA — disabled by default)
# ──────────────────────────────────────────────────────────────

# [FEATURE] Set to "true" to enable Twilio Voice AI routes
TWILIO_ENABLED=false

# [FEATURE] Required if TWILIO_ENABLED=true
# TWILIO_ACCOUNT_SID=ACREPLACE_ME
# TWILIO_AUTH_TOKEN=REPLACE_ME
# TWILIO_PHONE_NUMBER=+1XXXXXXXXXX


# ──────────────────────────────────────────────────────────────
# INTERNAL API (optional)
# ──────────────────────────────────────────────────────────────

# [OPTIONAL] Secret key for /internal/metrics/* endpoint authentication
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_SECRET_KEY=REPLACE_ME
